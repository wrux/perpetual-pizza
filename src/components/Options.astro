---
import { EFFECTS, effectLabels } from '../scripts/effects';
---

<div class="chrome topbar">
<header class="brand">
  <a class="brand__link" href="https://wrux.com" rel="author" title="Made by wrux.com">
    <svg class="brand__logo" viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <circle cx="32" cy="32" r="30" fill="#d9944a" />
      <circle cx="32" cy="32" r="24" fill="#f3cf6b" />
      <circle cx="21" cy="22" r="4.2" fill="#c4342b" />
      <circle cx="44" cy="20" r="4.2" fill="#c4342b" />
      <circle cx="47" cy="40" r="4.2" fill="#c4342b" />
      <circle cx="19" cy="42" r="4.2" fill="#c4342b" />
      <circle cx="33" cy="50" r="4.2" fill="#c4342b" />
      <path d="M27 36c3-1 4-5 7-5" stroke="#4f7d2e" stroke-width="2.4" stroke-linecap="round" fill="none" />
      <circle cx="32" cy="32" r="7.5" fill="#d9944a" />
      <circle cx="32" cy="32" r="5.5" fill="#f3cf6b" />
      <circle cx="30" cy="30.5" r="1.2" fill="#c4342b" />
      <circle cx="34.5" cy="33" r="1.2" fill="#c4342b" />
      <circle cx="32" cy="32" r="1.6" fill="#d9944a" />
    </svg>
    <span class="brand__text">
      <span class="brand__name">Perpetual Pizza</span>
      <span class="brand__by">by wrux.com</span>
    </span>
  </a>
</header>

<nav class="toolbar" aria-label="Page controls">
  <button type="button" class="toolbar__button" data-action="share" title="Copy a link to this pizza" aria-label="Copy a link to this pizza">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
      <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
    </svg>
  </button>
  <button type="button" id="toggle-options" class="toolbar__button" title="Options (O)" aria-label="Options" aria-expanded="false" aria-controls="options">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 7h10M18 7h2M4 12h2M10 12h10M4 17h8M16 17h4" />
      <circle cx="16" cy="7" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="14" cy="17" r="2" />
    </svg>
  </button>
  <button type="button" id="toggle-fullscreen" class="toolbar__button toggle-fullscreen" title="Fullscreen (F)" aria-label="Toggle fullscreen">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="fullscreen-out">
      <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
    </svg>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="fullscreen-in">
      <path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5" />
    </svg>
  </button>
</nav>
</div>

<aside id="options" class="options" aria-label="Pizza options">
  <div class="options__header">
    <h2>Options</h2>
    <button type="button" class="toolbar__button options__close" data-action="close" aria-label="Close options">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <form class="options__form" autocomplete="off">
    <fieldset>
      <legend>Look</legend>
      <div class="chips" role="radiogroup" aria-label="Shader">
        {
          EFFECTS.map((e) => (
            <label class="chip">
              <input type="radio" name="effect" value={e} data-key="effect" />
              <span>{effectLabels[e]}</span>
            </label>
          ))
        }
      </div>
      <label data-show-for="pixelate gameboy">
        <span>Pixel size <output data-output="pixelSize"></output></span>
        <input type="range" data-key="pixelSize" min="2" max="24" step="1" />
      </label>
      <label class="options__row">
        <span>Shadows</span>
        <input type="checkbox" class="switch" data-key="shadows" />
      </label>
    </fieldset>

    <fieldset>
      <legend>Motion</legend>
      <label>
        <span>Speed <output data-output="speed"></output></span>
        <input type="range" data-key="speed" min="0.25" max="4" step="0.05" />
      </label>
      <label>
        <span>Spin <output data-output="spinTurns"></output></span>
        <input type="range" data-key="spinTurns" min="-1" max="1" step="0.05" />
      </label>
      <div class="chips" role="radiogroup" aria-label="Direction">
        <label class="chip"><input type="radio" name="direction" value="1" data-key="direction" /><span>Zoom in</span></label>
        <label class="chip"><input type="radio" name="direction" value="-1" data-key="direction" /><span>Zoom out</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Camera</legend>
      <label>
        <span>Angle <output data-output="elevation"></output></span>
        <input type="range" data-key="elevation" min="15" max="90" step="1" />
      </label>
      <label>
        <span>Lens <output data-output="fov"></output></span>
        <input type="range" data-key="fov" min="25" max="80" step="1" />
      </label>
    </fieldset>

    <fieldset>
      <legend>Toppings</legend>
      <label>
        <span>Pepperoni <output data-output="toppings.pepperoni"></output></span>
        <input type="range" data-key="toppings.pepperoni" min="0" max="40" step="1" />
      </label>
      <label>
        <span>Mushroom <output data-output="toppings.mushroom"></output></span>
        <input type="range" data-key="toppings.mushroom" min="0" max="40" step="1" />
      </label>
      <label>
        <span>Basil <output data-output="toppings.basil"></output></span>
        <input type="range" data-key="toppings.basil" min="0" max="40" step="1" />
      </label>
      <label>
        <span>Olives <output data-output="toppings.olive"></output></span>
        <input type="range" data-key="toppings.olive" min="0" max="40" step="1" />
      </label>
      <button type="button" class="button button--small" data-action="shuffle">Shuffle toppings</button>
    </fieldset>

    <div class="options__footer">
      <button type="button" class="button button--small" data-action="share">Copy link</button>
      <button type="button" class="button button--small button--ghost" data-action="reset">Reset</button>
    </div>
  </form>
</aside>

<div class="toast" role="status" aria-live="polite" data-toast></div>

<style>
  /* ---- Shared chrome ------------------------------------------------ */
  .chrome {
    position: fixed;
    z-index: 7;
    transition: opacity 400ms ease;
  }

  body.is-idle .chrome,
  body.is-idle .toast {
    opacity: 0;
    pointer-events: none;
  }

  body.is-fullscreen .chrome,
  body.is-fullscreen .options {
    display: none;
  }

  /* ---- Top bar ------------------------------------------------------- */
  .topbar {
    top: calc(1.25rem + env(safe-area-inset-top));
    left: calc(1.25rem + env(safe-area-inset-left));
    right: calc(1.25rem + env(safe-area-inset-right));
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    pointer-events: none;
  }

  .topbar > * {
    pointer-events: auto;
  }

  /* ---- Brand --------------------------------------------------------- */
  .brand {
    min-width: 0;
  }

  .brand__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1rem 0.4rem 0.5rem;
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 1px 1px 6px rgba(0, 0, 0, 0.25);
    color: #fff;
    text-decoration: none;
    transition: background 333ms ease-in-out;
  }

  .brand__link:hover,
  .brand__link:focus-visible {
    background: rgba(20, 8, 2, 0.7);
  }

  .brand__logo {
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .brand__name {
    overflow: hidden;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .brand__by {
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .brand__link:hover .brand__by {
    text-decoration: underline;
    opacity: 1;
  }

  /* ---- Toolbar ------------------------------------------------------- */
  .toolbar {
    flex: none;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 1px 1px 6px rgba(0, 0, 0, 0.25);
  }

  .toolbar__button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .toolbar__button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toolbar__button:hover,
  .toolbar__button:focus-visible,
  .toolbar__button[aria-expanded='true'] {
    background: rgba(var(--primary), 0.85);
    outline: none;
  }

  .toggle-fullscreen .fullscreen-in,
  .toggle-fullscreen.open .fullscreen-out {
    display: none;
  }

  .toggle-fullscreen.open .fullscreen-in {
    display: block;
  }

  @media (pointer: coarse) {
    .toggle-fullscreen {
      display: none;
    }
  }

  /* ---- Panel --------------------------------------------------------- */
  .options {
    position: fixed;
    z-index: 6;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(22rem, 100vw);
    padding: 1.25rem 1.5rem 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgba(20, 8, 2, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.25);
    color: #fff;
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 360ms;
  }

  .options.open {
    transform: translateX(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .options__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    /* leave room for the toolbar pill above */
    padding-right: 9rem;
  }

  .options__header h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .options__close {
    display: none;
  }

  /* Phones: a bottom sheet instead of a side drawer. */
  @media (max-width: 640px) {
    .options {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 72dvh;
      padding: 0.6rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
      border-radius: 1.25rem 1.25rem 0 0;
      box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.3);
      transform: translateY(100%);
    }

    .options::before {
      content: '';
      display: block;
      width: 2.5rem;
      height: 4px;
      margin: 0 auto 0.75rem;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.35);
    }

    .options.open {
      transform: translateY(0);
    }

    .options__header {
      padding-right: 0;
      margin-bottom: 1rem;
    }

    .options__close {
      display: grid;
      background: rgba(255, 255, 255, 0.12);
    }

    .options__form {
      gap: 1.25rem;
    }

    .toast {
      bottom: calc(2rem + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 520px) {
    .brand__by {
      display: none;
    }

    .brand__link {
      padding-right: 0.9rem;
    }
  }

  @media (max-width: 360px) {
    .brand__text {
      display: none;
    }

    .brand__link {
      padding: 0.3rem;
    }
  }

  .options__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  fieldset {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.7rem;
    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.9rem;
  }

  label > span {
    display: flex;
    justify-content: space-between;
  }

  label[hidden] {
    display: none;
  }

  output {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .options__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  input[type='range'] {
    width: 100%;
    accent-color: rgb(var(--primary));
  }

  /* Toggle switch */
  .switch {
    appearance: none;
    width: 2.6rem;
    height: 1.5rem;
    margin: 0;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.25);
    position: relative;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 200ms ease;
  }

  .switch:checked {
    background: rgb(var(--primary));
  }

  .switch:checked::after {
    transform: translateX(1.1rem);
  }

  /* Chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    display: block;
    padding: 0.45em 1em;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 5rem;
    font-size: 0.85rem;
    font-weight: 600;
    transition:
      background 200ms ease,
      border-color 200ms ease;
  }

  .chip input:hover + span,
  .chip input:focus-visible + span {
    border-color: rgba(255, 255, 255, 0.7);
  }

  .chip input:checked + span {
    background: rgb(var(--primary));
    border-color: rgb(var(--primary));
  }

  .options__footer {
    display: flex;
    gap: 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .button--small {
    height: auto;
    padding: 0.45em 1.2em;
    font-size: 0.85rem;
    align-self: flex-start;
  }

  .button--ghost {
    --background-opacity: 0;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .button--ghost:hover,
  .button--ghost:focus {
    --background-opacity: 0;
    border-color: #fff;
  }

  /* ---- Toast --------------------------------------------------------- */
  .toast {
    position: fixed;
    z-index: 8;
    left: 50%;
    bottom: 2rem;
    padding: 0.6em 1.2em;
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.75);
    backdrop-filter: blur(14px);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    transform: translate(-50%, 1rem);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
  }
</style>
