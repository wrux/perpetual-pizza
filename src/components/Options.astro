---
import Logo from './Logo.astro';
import { EFFECTS, effectLabels } from '../scripts/effects';

const tabs = [
  { id: 'look', label: 'Look' },
  { id: 'motion', label: 'Motion' },
  { id: 'camera', label: 'Camera' },
  { id: 'toppings', label: 'Toppings' },
];
---

<div class="chrome topbar">
  <a class="glass brand" href="https://wrux.com" rel="author" title="Made by wrux.com">
    <Logo />
    <span>
      <b>Perpetual Pizza</b>
      <small>by wrux.com</small>
    </span>
  </a>

  <nav class="glass toolbar" aria-label="Page controls">
    <span class="anchor">
      <button type="button" data-action="share" title="Copy a link to this pizza" aria-label="Copy a link to this pizza">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
          <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
        </svg>
      </button>
      <span class="glass toast" role="status" aria-live="polite" data-toast="share">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
        <span data-toast-text>Link copied</span>
      </span>
    </span>
    <!-- Two icons: enter fullscreen, then leave it. -->
    <button type="button" id="toggle-fullscreen" title="Fullscreen (F)" aria-label="Toggle fullscreen">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
      </svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5" />
      </svg>
    </button>
  </nav>
</div>

<button type="button" id="toggle-options" class="chrome glass launcher" title="Customise (O)" aria-expanded="false" aria-controls="options">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M4 7h10M18 7h2M4 12h2M10 12h10M4 17h8M16 17h4" />
    <circle cx="16" cy="7" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="14" cy="17" r="2" />
  </svg>
  Customise
</button>

<aside id="options" class="glass dock" role="dialog" aria-labelledby="options-title">
  <header>
    <h2 id="options-title">Customise</h2>
    <div role="tablist" aria-label="Sections">
      {
        tabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} data-tab={t.id} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`pane-${t.id}`}>
            {t.label}
          </button>
        ))
      }
    </div>
    <span class="anchor">
      <button type="button" class="ghost" data-action="reset" title="Back to the default pizza">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
        Reset
      </button>
      <span class="glass toast" role="status" aria-live="polite" data-toast="reset">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
        <span data-toast-text>Back to default</span>
      </span>
    </span>
    <button type="button" class="ghost" data-action="close" title="Close (Esc)" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </header>

  <form autocomplete="off">
    <section id="pane-look" role="tabpanel" aria-labelledby="tab-look" data-pane="look">
      <div class="looks" role="radiogroup" aria-label="Shader">
        {
          EFFECTS.map((e) => (
            <label class="look">
              <input type="radio" name="effect" value={e} data-key="effect" />
              <span class="swatch" data-look-preview={e} aria-hidden="true" />
              {effectLabels[e]}
            </label>
          ))
        }
      </div>
    </section>

    <section id="pane-motion" class="grid" role="tabpanel" aria-labelledby="tab-motion" data-pane="motion" hidden>
      <label class="field">
        <span class="label">Speed <output data-output="speed"></output></span>
        <input type="range" data-key="speed" min="0.25" max="4" step="0.05" />
      </label>
      <label class="field">
        <span class="label">Spin <output data-output="spinTurns"></output></span>
        <input type="range" data-key="spinTurns" min="-1" max="1" step="0.05" />
      </label>
      <div class="field">
        <span class="label">Direction</span>
        <span class="segment" role="radiogroup" aria-label="Direction">
          <label><input type="radio" name="direction" value="1" data-key="direction" /><span>Zoom in</span></label>
          <label><input type="radio" name="direction" value="-1" data-key="direction" /><span>Zoom out</span></label>
        </span>
      </div>
    </section>

    <section id="pane-camera" class="grid" role="tabpanel" aria-labelledby="tab-camera" data-pane="camera" hidden>
      <label class="field">
        <span class="label">Angle <output data-output="elevation"></output></span>
        <input type="range" data-key="elevation" min="15" max="90" step="1" />
      </label>
      <label class="field">
        <span class="label">Lens <output data-output="fov"></output></span>
        <input type="range" data-key="fov" min="25" max="80" step="1" />
      </label>
    </section>

    <section id="pane-toppings" class="grid" role="tabpanel" aria-labelledby="tab-toppings" data-pane="toppings" hidden>
      {
        (
          [
            ['pepperoni', 'Pepperoni'],
            ['mushroom', 'Mushroom'],
            ['basil', 'Basil'],
            ['olive', 'Olives'],
            ['jalapeno', 'Jalapeño'],
            ['ham', 'Ham'],
          ] as const
        ).map(([key, label]) => (
          <label class="field topping">
            <span class="icon" data-topping-preview={key} aria-hidden="true" />
            <span class="label">
              {label} <output data-output={`toppings.${key}`} />
            </span>
            <input type="range" data-key={`toppings.${key}`} min="0" max="40" step="1" />
          </label>
        ))
      }
    </section>
  </form>
</aside>

<style is:global>
  /* ---- Everything that floats over the pizza --------------------------- */
  button {
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  :focus-visible,
  .look :focus-visible ~ .swatch,
  .segment :focus-visible + span {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .chrome {
    position: fixed;
    z-index: 7;
    transition: opacity 0.4s;
  }

  /* The chrome fades out when the viewer just wants to watch. */
  .is-idle :is(.chrome, .toast) {
    opacity: 0;
    pointer-events: none;
  }

  .is-fullscreen :is(.chrome, .dock) {
    display: none;
  }

  /* One frosted surface for all of it. */
  .glass {
    border: 1px solid var(--edge);
    border-radius: 5rem;
    background: #1408028c;
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      inset 0 1px #ffffff0f,
      0 6px 20px #0004;
  }

  /* A button with a confirmation bubble hanging off it. */
  .anchor {
    position: relative;
  }

  /* ---- Top bar --------------------------------------------------------- */
  .topbar {
    inset: calc(1.25rem + env(safe-area-inset-top)) calc(1.25rem + env(safe-area-inset-right)) auto
      calc(1.25rem + env(safe-area-inset-left));
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    pointer-events: none;
  }

  .topbar > * {
    pointer-events: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.4rem 1rem 0.4rem 0.45rem;
    color: #fff;
    line-height: 1.15;
    text-decoration: none;
    transition:
      background 0.25s,
      border-color 0.25s;
  }

  .brand:is(:hover, :focus-visible) {
    background: #140802b8;
    border-color: #fff4;
  }

  .brand svg {
    flex: none;
    width: 2.3rem;
    filter: drop-shadow(0 1px 2px #0005);
  }

  .brand span {
    min-width: 0;
  }

  .brand b {
    display: block;
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .brand small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--dim);
  }

  .brand:hover small {
    color: #fff;
  }

  .toolbar {
    display: flex;
    flex: none;
    gap: 0.2rem;
    padding: 0.25rem;
  }

  .toolbar button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    transition:
      background 0.18s,
      transform 0.12s;
  }

  .toolbar button:hover {
    background: var(--tint-2);
  }

  .toolbar button:active {
    transform: scale(0.94);
  }

  .toolbar svg {
    width: 1.2rem;
  }

  /* Only the icon for the next move shows. */
  #toggle-fullscreen:not(.open) svg + svg,
  #toggle-fullscreen.open svg:first-child {
    display: none;
  }

  @media (pointer: coarse) {
    #toggle-fullscreen {
      display: none;
    }
  }

  /* ---- Launcher -------------------------------------------------------- */
  .launcher {
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 0.55em;
    height: 2.9rem;
    padding: 0 1.35rem 0 1.1rem;
    font-size: 0.9rem;
    font-weight: 700;
    transform: translateX(-50%);
    transition:
      opacity 0.22s,
      transform 0.32s var(--ease),
      background 0.2s;
  }

  .launcher svg {
    width: 1.15rem;
  }

  .launcher:is(:hover, :focus-visible) {
    background: var(--primary);
  }

  .launcher:active {
    transform: translateX(-50%) scale(0.97);
  }

  /* While the dock is up the launcher drops out of the way. */
  .options-open .launcher {
    opacity: 0;
    transform: translate(-50%, 1.5rem);
    pointer-events: none;
  }

  /* ---- Dock ------------------------------------------------------------ */
  .dock {
    --pad: 1.1rem;

    position: fixed;
    z-index: 6;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    width: min(46rem, 100vw - 2.5rem);
    border-radius: 1.4rem;
    background: #120803bd;
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    backdrop-filter: blur(24px) saturate(1.4);
    box-shadow:
      inset 0 1px #ffffff0f,
      0 16px 48px #0000005a;
    font-size: 0.85rem;
    transform: translate(-50%, calc(100% + 2.5rem));
    visibility: hidden;
    transition:
      transform 0.38s var(--ease),
      visibility 0s 0.38s;
  }

  .dock.open {
    transform: translateX(-50%);
    visibility: visible;
    transition-delay: 0s;
  }

  .dock.dragging {
    transition: none;
  }

  /* One row: the sections on the left, reset and close on the right. */
  .dock header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem var(--pad) 0;
  }

  .dock h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  /* With room for the tabs beside the buttons the heading is only there for screen readers. */
  @media (min-width: 641px) {
    .dock h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  [role='tablist'] {
    display: flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border-radius: 5rem;
    background: var(--tint);
  }

  [role='tab'] {
    flex: 1;
    padding: 0.4em 1.15em;
    border-radius: 5rem;
    color: var(--dim);
    font-weight: 600;
    transition:
      background 0.16s,
      color 0.16s;
  }

  [role='tab']:hover {
    color: #fff;
  }

  [aria-selected='true'] {
    background: var(--tint-2);
    color: #fff;
  }

  .dock .anchor {
    margin-left: auto;
  }

  /* Reset and close: quiet until hovered. */
  .ghost {
    display: flex;
    align-items: center;
    gap: 0.4em;
    height: 2rem;
    padding: 0 0.75em;
    border-radius: 5rem;
    color: var(--dim);
    font-size: 0.8rem;
    font-weight: 600;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .ghost:hover {
    color: #fff;
    background: var(--tint-2);
  }

  .ghost svg {
    width: 1rem;
  }

  /* The close button is only an icon. */
  .ghost[aria-label] {
    width: 2rem;
    margin: 0 -0.35rem 0 -0.6rem;
    padding: 0;
    justify-content: center;
  }

  .dock form {
    padding: 0.9rem var(--pad) var(--pad);
    overflow: hidden;
    transition: height 0.26s var(--ease);
  }

  [role='tabpanel'] {
    animation: pane-in 0.22s;
  }

  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  /* ---- Looks: picture tiles -------------------------------------------- */
  .looks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr));
    gap: 0.5rem;
  }

  .look {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.2rem 0.45rem;
    border-radius: 0.8rem;
    color: #fffc;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.15s;
  }

  .look:hover {
    background: var(--tint);
  }

  .look:has(:checked) {
    color: #fff;
  }

  /* Radio buttons are covered by what they pick: invisible, but still there to click and focus. */
  :is(.look, .segment) input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* A render of the look once there is one, a dark tile until then. */
  .swatch {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 0.7rem;
    background: var(--preview, #2a1208) center / cover;
    box-shadow:
      inset 0 0 0 1px var(--edge),
      0 2px 6px #0004;
    transition:
      transform 0.16s,
      box-shadow 0.16s;
  }

  :checked ~ .swatch {
    box-shadow:
      inset 0 0 0 2px var(--primary),
      0 0 0 2px #d0000073,
      0 2px 6px #0004;
    transform: translateY(-1px);
  }

  /* ---- Fields ---------------------------------------------------------- */
  .grid:not([hidden]) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    align-items: start;
  }

  #pane-toppings {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    min-height: 1.4rem;
    font-weight: 500;
  }

  output {
    padding: 0.1em 0.5em;
    border-radius: 5rem;
    background: var(--tint-2);
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .topping {
    grid-template-columns: auto 1fr;
    gap: 0 0.7rem;
    align-items: center;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border-radius: 0.9rem;
    background: var(--tint);
    transition: background 0.15s;
  }

  .topping:is(:hover, :focus-within) {
    background: var(--tint-2);
  }

  .icon {
    grid-row: span 2;
    width: 2.9rem;
    height: 2.9rem;
    /* The renders leave a margin around the topping, so they are shown a little oversized. */
    background: var(--preview, none) center / 125% no-repeat;
    filter: drop-shadow(0 2px 3px #0006);
    transition:
      opacity 0.2s,
      filter 0.2s;
  }

  /* A topping that is switched off fades back. */
  .is-off .icon {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .is-off output {
    color: var(--dim);
  }

  /* Range sliders: one look in every browser, with the filled part of the track. */
  [type='range'] {
    --p: 50%;

    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 1.75rem;
    margin: 0;
    background: none;
    cursor: pointer;
  }

  ::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--primary) var(--p), #fff3 var(--p));
  }

  ::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: #fff3;
  }

  ::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--primary);
  }

  ::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: calc(2px - 0.525rem);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px #0006;
  }

  ::-moz-range-thumb {
    width: 1.05rem;
    height: 1.05rem;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px #0006;
  }

  /* Segmented control */
  .segment {
    display: flex;
    justify-self: start;
    height: 1.75rem;
    padding: 0.15rem;
    border-radius: 5rem;
    background: var(--tint);
  }

  .segment label {
    position: relative;
  }

  .segment span {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.9em;
    border-radius: 5rem;
    color: var(--dim);
    font-size: 0.8rem;
    font-weight: 600;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .segment :hover + span {
    color: #fff;
  }

  .segment :checked + span {
    background: var(--primary);
    color: #fff;
  }

  /* ---- Confirmation bubble, hanging off the button that was pressed ----- */
  .toast {
    position: absolute;
    top: calc(100% + 0.9rem);
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5em 0.9em;
    background: #120803d9;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    transform: translateY(-0.4rem);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s,
      transform 0.22s var(--ease);
  }

  /* Little arrow pointing up at the button. */
  .toast::before {
    content: '';
    position: absolute;
    top: -0.35rem;
    right: 0.9rem;
    width: 0.7rem;
    height: 0.7rem;
    border: solid var(--edge);
    border-width: 1px 0 0 1px;
    background: inherit;
    transform: rotate(45deg);
  }

  .toast svg {
    width: 1em;
    color: #7ee08a;
  }

  .toast.show {
    transform: none;
    opacity: 1;
  }

  /* ---- Phones: a floating sheet you can swipe away --------------------- */
  @media (max-width: 640px) {
    .dock {
      --pad: 1.25rem;

      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      width: auto;
      transform: translateY(calc(100% + 2rem));
    }

    .dock.open {
      transform: none;
    }

    /* Heading and buttons on one row, the tabs on the next, under a grip to drag by. */
    .dock header {
      flex-wrap: wrap;
      padding-top: 1.5rem;
      touch-action: none;
    }

    .dock header::before {
      content: '';
      position: absolute;
      top: 0.6rem;
      left: calc(50% - 1.125rem);
      width: 2.25rem;
      height: 4px;
      border-radius: 2px;
      background: #fff5;
    }

    [role='tablist'] {
      order: 1;
      flex: 0 0 100%;
    }

    [role='tab'] {
      padding: 0.5em 0.4em;
      font-size: 0.82rem;
    }

    .dock form {
      max-height: 52dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-top: 1.1rem;
    }

    .looks {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.6rem 0.4rem;
    }

    .grid:not([hidden]) {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    /* Two columns keep all six toppings on screen without scrolling. */
    #pane-toppings {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    .topping {
      column-gap: 0.45rem;
      padding: 0.45rem 0.6rem 0.45rem 0.35rem;
    }

    .icon {
      width: 2.4rem;
      height: 2.4rem;
    }
  }

  @media (max-width: 520px) {
    .brand small {
      display: none;
    }

    .brand {
      padding-right: 0.9rem;
    }
  }

  @media (max-width: 360px) {
    .brand span {
      display: none;
    }

    .brand {
      padding: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock,
    .dock form,
    [role='tabpanel'],
    .swatch,
    .toolbar button {
      transition: none;
      animation: none;
    }
  }
