---
import { EFFECTS, effectLabels } from '../scripts/effects';

const tabs = [
  { id: 'look', label: 'Look' },
  { id: 'motion', label: 'Motion' },
  { id: 'camera', label: 'Camera' },
  { id: 'toppings', label: 'Toppings' },
];
---

<div class="chrome topbar">
  <header class="brand">
    <a class="brand__link" href="https://wrux.com" rel="author" title="Made by wrux.com">
      <svg class="brand__logo" viewBox="0 0 64 64" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="32" r="30" fill="#d9944a" />
        <circle cx="32" cy="32" r="24" fill="#f3cf6b" />
        <circle cx="21" cy="22" r="4.2" fill="#c4342b" />
        <circle cx="44" cy="20" r="4.2" fill="#c4342b" />
        <circle cx="47" cy="40" r="4.2" fill="#c4342b" />
        <circle cx="19" cy="42" r="4.2" fill="#c4342b" />
        <circle cx="33" cy="50" r="4.2" fill="#c4342b" />
        <path d="M27 36c3-1 4-5 7-5" stroke="#4f7d2e" stroke-width="2.4" stroke-linecap="round" fill="none" />
        <circle cx="32" cy="32" r="7.5" fill="#d9944a" />
        <circle cx="32" cy="32" r="5.5" fill="#f3cf6b" />
        <circle cx="30" cy="30.5" r="1.2" fill="#c4342b" />
        <circle cx="34.5" cy="33" r="1.2" fill="#c4342b" />
        <circle cx="32" cy="32" r="1.6" fill="#d9944a" />
      </svg>
      <span class="brand__text">
        <span class="brand__name">Perpetual Pizza</span>
        <span class="brand__by">by wrux.com</span>
      </span>
    </a>
  </header>

  <nav class="toolbar" aria-label="Page controls">
    <button type="button" class="toolbar__button" data-action="share" title="Copy a link to this pizza" aria-label="Copy a link to this pizza">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
        <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
      </svg>
    </button>
    <button type="button" id="toggle-fullscreen" class="toolbar__button toggle-fullscreen" title="Fullscreen (F)" aria-label="Toggle fullscreen">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="fullscreen-out">
        <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
      </svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="fullscreen-in">
        <path d="M3 8h5V3M21 8h-5V3M3 16h5v5M21 16h-5v5" />
      </svg>
    </button>
  </nav>
</div>

<button type="button" id="toggle-options" class="chrome launcher" title="Customise (O)" aria-expanded="false" aria-controls="options">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M4 7h10M18 7h2M4 12h2M10 12h10M4 17h8M16 17h4" />
    <circle cx="16" cy="7" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="14" cy="17" r="2" />
  </svg>
  <span>Customise</span>
</button>

<aside id="options" class="dock" role="dialog" aria-labelledby="options-title">
  <div class="dock__grip" aria-hidden="true"></div>
  <header class="dock__header">
    <h2 id="options-title" class="dock__title">Customise</h2>
    <div class="dock__actions">
      <button type="button" class="dock__action" data-action="reset">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
        Reset
      </button>
      <button type="button" class="dock__action dock__action--icon" data-action="close" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
  </header>

  <div class="dock__tabs" role="tablist" aria-label="Sections">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          class="dock__tab"
          data-tab={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`pane-${t.id}`}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <form class="dock__panes" autocomplete="off">
    <section id="pane-look" class="dock__pane" role="tabpanel" aria-labelledby="tab-look" data-pane="look">
      <div class="looks" role="radiogroup" aria-label="Shader">
        {
          EFFECTS.map((e) => (
            <label class="look">
              <input type="radio" name="effect" value={e} data-key="effect" />
              <span class={`look__swatch look__swatch--${e}`} data-look-preview={e} aria-hidden="true" />
              <span class="look__name">{effectLabels[e]}</span>
            </label>
          ))
        }
      </div>
    </section>

    <section id="pane-motion" class="dock__pane" role="tabpanel" aria-labelledby="tab-motion" data-pane="motion" hidden>
      <div class="grid">
        <label class="field">
          <span class="field__label">Speed <output data-output="speed"></output></span>
          <span class="field__control"><input type="range" data-key="speed" min="0.25" max="4" step="0.05" /></span>
        </label>
        <label class="field">
          <span class="field__label">Spin <output data-output="spinTurns"></output></span>
          <span class="field__control"><input type="range" data-key="spinTurns" min="-1" max="1" step="0.05" /></span>
        </label>
        <div class="field">
          <span class="field__label">Direction</span>
          <span class="field__control">
            <span class="segment" role="radiogroup" aria-label="Direction">
              <label><input type="radio" name="direction" value="1" data-key="direction" /><span>Zoom in</span></label>
              <label><input type="radio" name="direction" value="-1" data-key="direction" /><span>Zoom out</span></label>
            </span>
          </span>
        </div>
      </div>
    </section>

    <section id="pane-camera" class="dock__pane" role="tabpanel" aria-labelledby="tab-camera" data-pane="camera" hidden>
      <div class="grid">
        <label class="field">
          <span class="field__label">Angle <output data-output="elevation"></output></span>
          <span class="field__control"><input type="range" data-key="elevation" min="15" max="90" step="1" /></span>
        </label>
        <label class="field">
          <span class="field__label">Lens <output data-output="fov"></output></span>
          <span class="field__control"><input type="range" data-key="fov" min="25" max="80" step="1" /></span>
        </label>
      </div>
    </section>

    <section id="pane-toppings" class="dock__pane" role="tabpanel" aria-labelledby="tab-toppings" data-pane="toppings" hidden>
      <div class="grid grid--toppings">
        {
          (
            [
              ['pepperoni', 'Pepperoni'],
              ['mushroom', 'Mushroom'],
              ['basil', 'Basil'],
              ['olive', 'Olives'],
              ['jalapeno', 'Jalapeño'],
              ['ham', 'Ham'],
            ] as const
          ).map(([key, label]) => (
            <label class="field topping">
              <span class="topping__icon" data-topping-preview={key} aria-hidden="true" />
              <span class="field__label">
                {label} <output data-output={`toppings.${key}`} />
              </span>
              <span class="field__control">
                <input type="range" data-key={`toppings.${key}`} min="0" max="40" step="1" />
              </span>
            </label>
          ))
        }
      </div>
      <button type="button" class="dock__button" data-action="shuffle">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
        Shuffle toppings
      </button>
    </section>
  </form>
</aside>

<div class="toast" role="status" aria-live="polite" data-toast></div>

<style>
  /* ---- Shared chrome ------------------------------------------------ */
  .chrome {
    position: fixed;
    z-index: 7;
    transition: opacity 400ms ease;
  }

  body.is-idle .chrome,
  body.is-idle .toast {
    opacity: 0;
    pointer-events: none;
  }

  body.is-fullscreen .chrome,
  body.is-fullscreen .dock {
    display: none;
  }

  :where(.chrome, .dock) :focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* ---- Top bar ------------------------------------------------------- */
  .topbar {
    top: calc(1.25rem + env(safe-area-inset-top));
    left: calc(1.25rem + env(safe-area-inset-left));
    right: calc(1.25rem + env(safe-area-inset-right));
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    pointer-events: none;
  }

  .topbar > * {
    pointer-events: auto;
  }

  .brand {
    min-width: 0;
  }

  .brand__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 1rem 0.4rem 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.5);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    color: #fff;
    text-decoration: none;
    transition:
      background 250ms ease,
      border-color 250ms ease;
  }

  .brand__link:hover,
  .brand__link:focus-visible {
    background: rgba(20, 8, 2, 0.72);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .brand__logo {
    width: 2.3rem;
    height: 2.3rem;
    flex: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .brand__name {
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .brand__by {
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.65);
  }

  .brand__link:hover .brand__by {
    color: #fff;
  }

  .toolbar {
    flex: none;
    display: flex;
    gap: 0.2rem;
    padding: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.5);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .toolbar__button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition:
      background 180ms ease,
      transform 120ms ease;
  }

  .toolbar__button svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .toolbar__button:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .toolbar__button:active {
    transform: scale(0.94);
  }

  .toolbar__button[aria-expanded='true'] {
    background: rgb(var(--primary));
  }

  .toggle-fullscreen .fullscreen-in,
  .toggle-fullscreen.open .fullscreen-out {
    display: none;
  }

  .toggle-fullscreen.open .fullscreen-in {
    display: block;
  }

  @media (pointer: coarse) {
    .toggle-fullscreen {
      display: none;
    }
  }

  /* ---- Launcher ------------------------------------------------------ */
  .launcher {
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    height: 2.9rem;
    padding: 0 1.35rem 0 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5rem;
    background: rgba(20, 8, 2, 0.5);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transform: translateX(-50%);
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background 200ms ease;
  }

  .launcher svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .launcher:hover,
  .launcher:focus-visible {
    background: rgb(var(--primary));
  }

  .launcher:active {
    transform: translateX(-50%) scale(0.97);
  }

  /* While the dock is up the launcher drops out of the way. */
  body.options-open .launcher {
    opacity: 0;
    transform: translate(-50%, 1.5rem);
    pointer-events: none;
  }

  /* ---- Dock ---------------------------------------------------------- */
  .dock {
    --pad: 1.1rem;

    position: fixed;
    z-index: 6;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    width: min(46rem, calc(100vw - 2.5rem));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.4rem;
    background: rgba(18, 8, 3, 0.72);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    color: #fff;
    font-size: 0.85rem;
    transform: translate(-50%, calc(100% + 2.5rem));
    visibility: hidden;
    transition:
      transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 380ms;
  }

  .dock.open {
    transform: translate(-50%, 0);
    visibility: visible;
    transition-delay: 0s;
  }

  .dock.dragging {
    transition: none;
  }

  .dock__grip {
    display: none;
  }

  .dock__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem var(--pad) 0;
  }

  .dock__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .dock__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-right: -0.35rem;
  }

  .dock__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2rem;
    padding: 0 0.75em;
    border: 0;
    border-radius: 5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .dock__action svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .dock__action:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .dock__action--icon {
    width: 2rem;
    padding: 0;
    justify-content: center;
  }

  .dock__action--icon svg {
    width: 1rem;
    height: 1rem;
  }

  .dock__tabs {
    display: flex;
    gap: 0.15rem;
    margin: 0.75rem var(--pad) 0;
    padding: 0.2rem;
    border-radius: 5rem;
    background: rgba(255, 255, 255, 0.07);
  }

  .dock__tab {
    flex: 1;
    padding: 0.45em 0.9em;
    border: 0;
    border-radius: 5rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    font: inherit;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .dock__tab:hover {
    color: #fff;
  }

  .dock__tab[aria-selected='true'] {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .dock__panes {
    padding: 1rem var(--pad) var(--pad);
    overflow: hidden;
    transition: height 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dock__pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: pane-in 220ms ease;
  }

  .dock__pane[hidden] {
    display: none;
  }

  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- Looks: visual tiles ------------------------------------------- */
  .looks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr));
    gap: 0.5rem;
  }

  .look {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.2rem 0.45rem;
    border-radius: 0.8rem;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .look:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .look input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .look input:focus-visible ~ .look__swatch {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .look__swatch {
    --pizza:
      radial-gradient(circle at 36% 34%, #c4342b 0 9%, transparent 10%),
      radial-gradient(circle at 66% 40%, #c4342b 0 8%, transparent 9%),
      radial-gradient(circle at 50% 68%, #c4342b 0 9%, transparent 10%),
      radial-gradient(circle at 50% 50%, #f3cf6b 0 36%, #d9944a 37% 46%, #f0a040 47%);

    position: relative;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 0.7rem;
    background: var(--pizza);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 2px 6px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .look__swatch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .look input:checked ~ .look__swatch {
    box-shadow:
      inset 0 0 0 2px rgb(var(--primary)),
      0 0 0 2px rgba(var(--primary), 0.45),
      0 2px 6px rgba(0, 0, 0, 0.25);
    transform: translateY(-1px);
  }

  .look__name {
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
  }

  .look input:checked ~ .look__name {
    color: #fff;
  }

  /* Once a real render exists it replaces the CSS stand-in. */
  .look__swatch.has-preview {
    background: var(--preview) center / cover no-repeat;
  }

  .look__swatch.has-preview::after {
    display: none;
  }

  /* Each tile previews its look with pure CSS. */
  .look__swatch--pixelate::after {
    background:
      linear-gradient(rgba(0, 0, 0, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.22) 1px, transparent 1px);
    background-size: 6px 6px;
  }

  .look__swatch--cartoon {
    --pizza:
      radial-gradient(circle at 36% 34%, #1a0a08 0 10%, #d33a2e 11% 19%, transparent 20%),
      radial-gradient(circle at 66% 40%, #1a0a08 0 9%, #d33a2e 10% 17%, transparent 18%),
      radial-gradient(circle at 50% 68%, #1a0a08 0 10%, #d33a2e 11% 19%, transparent 20%),
      radial-gradient(circle at 50% 50%, #ffd966 0 35%, #1a0a08 36% 38%, #e0a050 39% 46%, #1a0a08 47% 49%, #ffb050 50%);
  }

  .look__swatch--halftone::after {
    background: radial-gradient(circle, rgba(0, 0, 0, 0.55) 0 1.2px, transparent 1.6px);
    background-size: 5px 5px;
    mix-blend-mode: multiply;
  }

  .look__swatch--gameboy {
    --pizza:
      radial-gradient(circle at 36% 34%, #0f380f 0 9%, transparent 10%),
      radial-gradient(circle at 66% 40%, #0f380f 0 8%, transparent 9%),
      radial-gradient(circle at 50% 68%, #0f380f 0 9%, transparent 10%),
      radial-gradient(circle at 50% 50%, #9bbc0f 0 36%, #306230 37% 46%, #8bac0f 47%);
  }

  .look__swatch--gameboy::after {
    background:
      linear-gradient(rgba(15, 56, 15, 0.35) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 56, 15, 0.35) 1px, transparent 1px);
    background-size: 5px 5px;
  }

  .look__swatch--vhs::after {
    background:
      linear-gradient(rgba(0, 0, 0, 0.3) 50%, transparent 50%),
      linear-gradient(90deg, rgba(255, 0, 80, 0.35), transparent 30%, transparent 70%, rgba(0, 200, 255, 0.35));
    background-size:
      100% 3px,
      100% 100%;
    transform: skewX(-6deg) scaleX(1.1);
  }

  .look__swatch--crt {
    border-radius: 0.9rem;
  }

  .look__swatch--crt::after {
    background:
      linear-gradient(rgba(0, 0, 0, 0.35) 50%, transparent 50%),
      radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.75) 100%);
    background-size:
      100% 3px,
      100% 100%;
  }

  .look__swatch--psychedelic {
    --pizza:
      radial-gradient(circle at 36% 34%, #ff2d95 0 9%, transparent 10%),
      radial-gradient(circle at 66% 40%, #00e5ff 0 8%, transparent 9%),
      radial-gradient(circle at 50% 68%, #ffe600 0 9%, transparent 10%),
      conic-gradient(from 40deg, #ff0066, #ffcc00, #33ff99, #0099ff, #cc33ff, #ff0066);
  }

  /* ---- Fields -------------------------------------------------------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    align-items: start;
  }

  .grid--toppings {
    grid-template-columns: repeat(3, 1fr);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
