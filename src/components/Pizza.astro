---
import Loading from './Loading.astro';
import Options from './Options.astro';
---

<canvas id="pizza" aria-label="The never ending digital pizza"></canvas>
<Loading />
<Options />

<script>
  import { createPizza } from '../scripts/pizza';
  import { initPanel, optionsFromUrl } from '../scripts/panel';

  const canvas = document.getElementById('pizza') as HTMLCanvasElement;
  const loader = document.getElementById('loading');
  const caption = loader?.querySelector<HTMLElement>('[data-caption]');
  const bar = loader?.querySelector<HTMLElement>('[data-bar]');

  const progress = (text: string, fraction: number) => {
    if (caption) caption.textContent = text;
    if (bar) bar.style.transform = `scaleX(${fraction})`;
  };
  // If the pizza can't be drawn (no WebGL2, or a graphics error), swap the loader for a few words about the site.
  const pizza = await createPizza(canvas, optionsFromUrl(), progress).catch((error: unknown) => {
    loader?.classList.add('failed');
    loader?.removeAttribute('aria-live');
    throw error;
  });
  progress('Plating up', 0.9);
  await initPanel(pizza);
  progress('Ready', 1);

  // Lift the loader only once everything is drawn and a couple of frames have run smoothly behind it.
  const frame = () => new Promise(requestAnimationFrame);
  await frame();
  await frame();
  loader?.classList.add('done');
  loader?.addEventListener('transitionend', () => loader.remove(), { once: true });

  // Handy for poking at from the console.
  (window as unknown as { pizza: typeof pizza }).pizza = pizza;
</script>

<style is:global>
  #pizza {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
  }
</style>
