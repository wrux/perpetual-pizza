<style>
  .loading {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background: #140802;
    color: #fff;
    transition:
      opacity 500ms ease,
      visibility 0s linear 500ms;
  }

  .loading.done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loading__pizza {
    width: 3.5rem;
    height: 3.5rem;
    /* A transform animation keeps running on the compositor while the main thread paints textures. */
    animation: loading-breathe 1.6s ease-in-out infinite;
  }

  .loading__bar {
    width: 9rem;
    height: 2px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .loading__fill {
    width: 100%;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms ease;
  }

  .loading__caption {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.55);
  }

  @keyframes loading-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading__pizza {
      animation: none;
    }
  }
</style>
