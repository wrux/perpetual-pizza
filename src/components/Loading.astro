---
import Logo from './Logo.astro';
---

<div id="loading" class="loading" role="status" aria-live="polite">
  <Logo />
  <div aria-hidden="true"><div data-bar></div></div>
  <p data-caption>Preheating the oven</p>
  <section class="fallback" aria-label="About this page">
    <p>
      <b>Perpetual Pizza</b> is a never ending digital pizza that zooms in forever. <span data-reason
        >Your browser can't draw it: it needs JavaScript and WebGL2.</span
      >
    </p>
    <p><a href="/about">Read about Perpetual Pizza</a></p>
  </section>
</div>

<!-- Without JavaScript nothing will ever finish loading, so say so straight away. -->
<noscript><style>.loading .fallback { display: block; } .loading > div, .loading [data-caption] { display: none; }</style></noscript>

<style is:global>
  .loading {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    background: #140802;
    transition:
      opacity 0.5s,
      visibility 0s 0.5s;
  }

  .loading.done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* A transform animation keeps running on the compositor while the main thread paints textures. */
  .loading svg {
    width: 3.5rem;
    animation: breathe 1.6s ease-in-out infinite;
  }

  /* The progress bar, and the fill inside it. */
  .loading div {
    width: 9rem;
    height: 2px;
    border-radius: 1px;
    background: #fff2;
    overflow: hidden;
  }

  .loading div div {
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }

  .loading p {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #fff9;
  }

  /* Shown only when the pizza can't be drawn. */
  .loading .fallback {
    display: none;
    max-width: 22rem;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #fffc;
  }

  .loading .fallback p {
    font: inherit;
    letter-spacing: normal;
    color: inherit;
  }

  .loading .fallback p + p {
    margin-top: 0.75rem;
  }

  .loading .fallback a {
    color: #fff;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .loading.failed .fallback {
    display: block;
  }

  .loading.failed > div,
  .loading.failed [data-caption] {
    display: none;
  }

  .loading.failed svg {
    animation: none;
  }

  @keyframes breathe {
    50% {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading svg {
      animation: none;
    }
  }
</style>
