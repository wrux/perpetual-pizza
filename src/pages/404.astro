---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="Page not found | Perpetual Pizza" description="This page doesn't exist." path="/404" noindex>
  <main class="lost">
    <Logo />
    <h1>This slice has been eaten</h1>
    <p>There's nothing at this address. The pizza is still spinning on the homepage.</p>
    <p class="links"><a href="/">Back to the pizza</a> <a href="/about">About Perpetual Pizza</a></p>
  </main>
</Layout>

<style>
  .lost {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 2rem 1rem;
    text-align: center;
  }

  .lost :global(svg) {
    width: 4rem;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: 1.6rem;
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: #fffb;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin-top: 0.5rem;
  }

  a {
    color: #fff;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }
</style>
